{
  "name": "dsh-evolve",
  "version": "0.1.0",
  "description": "Evidence-driven runtime optimization for DeepSeek Harness: deterministic stuck detection + STRATEGY_RESET intervention, as a detachable DSH plugin.",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/Atman-Angle/dsh-evolve.git"
  },
  "bugs": {
    "url": "https://github.com/Atman-Angle/dsh-evolve/issues"
  },
  "homepage": "https://github.com/Atman-Angle/dsh-evolve#readme",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "dsh-evolve": "lib/offline/bin.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "recipes",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "analyze": "node lib/offline/bin.js analyze",
    "audit": "node lib/offline/bin.js audit --all",
    "benchmark": "node lib/offline/bin.js benchmark"
  },
  "engines": {
    "node": ">=22.19"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc.7",
    "@deepseek-ai/dsh-agent": ">=0",
    "@deepseek-ai/dsh-llm": ">=0",
    "@deepseek-ai/dsh-session": ">=0",
    "@deepseek-ai/schemastery": ">=3.18.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../deepseek-harness/vendor/cordis",
    "@deepseek-ai/dsh-agent": "link:../deepseek-harness/packages/core/agent",
    "@deepseek-ai/dsh-llm": "link:../deepseek-harness/packages/llm/llm",
    "@deepseek-ai/dsh-session": "link:../deepseek-harness/packages/core/session",
    "@deepseek-ai/dsh-tools": "link:../deepseek-harness/packages/core/tools",
    "@deepseek-ai/schemastery": "link:../deepseek-harness/vendor/schemastery",
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
